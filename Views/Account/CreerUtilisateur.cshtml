@model PerformanceEtudiante.ViewModels.CreerUtilisateurViewModel
@{
    ViewData["Title"] = "Créer un utilisateur";
}

<div class="px-3">
    <!-- Header -->
    <div class="d-flex align-items-center mb-4">
        <div class="me-3" style="width:50px;height:50px;background:linear-gradient(135deg,#34a853,#1e7e34);border-radius:12px;display:flex;align-items:center;justify-content:center;">
            <i class="fas fa-user-plus text-white fa-lg"></i>
        </div>
        <div>
            <h2 class="mb-0 fw-bold">Créer un utilisateur</h2>
            <p class="text-muted mb-0 small">
                <a asp-action="GestionUtilisateurs" class="text-muted text-decoration-none">
                    <i class="fas fa-arrow-left me-1"></i>Retour à la liste
                </a>
            </p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <form asp-action="CreerUtilisateur" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

                <!-- Informations personnelles -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="mb-0 fw-semibold">
                            <i class="fas fa-id-card me-2 text-primary"></i>Informations personnelles
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Prenom" class="form-label fw-semibold"></label>
                                <input asp-for="Prenom" class="form-control" placeholder="ex: Ahmed" autofocus />
                                <span asp-validation-for="Prenom" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Nom" class="form-label fw-semibold"></label>
                                <input asp-for="Nom" class="form-control" placeholder="ex: Ben Ali" />
                                <span asp-validation-for="Nom" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-at text-muted"></i></span>
                                    <input asp-for="Email" class="form-control" placeholder="email@exemple.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Telephone" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-phone text-muted"></i></span>
                                    <input asp-for="Telephone" class="form-control" placeholder="+216 XX XXX XXX" />
                                </div>
                                <span asp-validation-for="Telephone" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DateNaissance" class="form-label fw-semibold"></label>
                                <input asp-for="DateNaissance" class="form-control" type="date" />
                                <span asp-validation-for="DateNaissance" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Rôle -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="mb-0 fw-semibold">
                            <i class="fas fa-user-tag me-2 text-warning"></i>Attribution du rôle
                        </h6>
                    </div>
                    <div class="card-body">
                        <label asp-for="Role" class="form-label fw-semibold"></label>
                        <div class="row g-3 mt-1">
                            @foreach (var role in Model.RolesDisponibles)

                            {

                                var (icon, color, desc) = role switch
                                {

                                    "Administrateur" => ("user-shield", "danger", "Accès complet à la gestion de l'application"),

                                    "Enseignant" => ("chalkboard-teacher", "success", "Saisie des notes et gestion des ressources"),

                                    _ => ("user-graduate", "primary", "Consultation des notes et performances")

                                };
                                <div class="col-md-4">
                                    <div class="form-check role-card border rounded-3 p-3 h-100" style="cursor:pointer;">
                                        <input class="form-check-input" type="radio" asp-for="Role"
                                               id="role_@role" value="@role"
                                               checked="@(role == "Etudiant")" />
                                        <label class="form-check-label w-100" for="role_@role" style="cursor:pointer;">
                                            <div class="d-flex align-items-center mb-1">
                                                <i class="fas fa-@icon text-@color me-2"></i>
                                                <span class="fw-semibold">@role</span>
                                            </div>
                                            <p class="text-muted small mb-0">@desc</p>
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Classe et groupe -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="mb-0 fw-semibold">
                            <i class="fas fa-sitemap me-2 text-info"></i>Affectation classe / groupe
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="ClasseId" class="form-label fw-semibold"></label>
                                <select asp-for="ClasseId" class="form-select" asp-items="Model.Classes">
                                    <option value="">Sélectionner</option>
                                </select>
                                <span asp-validation-for="ClasseId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="GroupeId" class="form-label fw-semibold"></label>
                                <select asp-for="GroupeId" class="form-select" asp-items="Model.Groupes">
                                    <option value="">Sélectionner</option>
                                </select>
                                <span asp-validation-for="GroupeId" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Mot de passe -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="mb-0 fw-semibold">
                            <i class="fas fa-lock me-2 text-secondary"></i>Mot de passe
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="MotDePasse" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <input asp-for="MotDePasse" class="form-control" id="pwd1" placeholder="••••••••" />
                                    <button class="btn btn-outline-secondary" type="button" onclick="togglePwd('pwd1','eye1')">
                                        <i class="fas fa-eye" id="eye1"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="MotDePasse" class="text-danger small"></span>
                                <p class="text-muted small mt-1">Min. 8 caractères, maj, min, chiffre et symbole</p>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmerMotDePasse" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <input asp-for="ConfirmerMotDePasse" class="form-control" id="pwd2" placeholder="••••••••" />
                                    <button class="btn btn-outline-secondary" type="button" onclick="togglePwd('pwd2','eye2')">
                                        <i class="fas fa-eye" id="eye2"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmerMotDePasse" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Boutons -->
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success px-5">
                        <i class="fas fa-user-plus me-2"></i>Créer l'utilisateur
                    </button>
                    <a asp-action="GestionUtilisateurs" class="btn btn-outline-secondary px-4">
                        <i class="fas fa-times me-2"></i>Annuler
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
function togglePwd(inputId, iconId) {
    const input = document.getElementById(inputId);
    const icon = document.getElementById(iconId);
    input.type = input.type === 'password' ? 'text' : 'password';
    icon.classList.toggle('fa-eye');
    icon.classList.toggle('fa-eye-slash');
}

// Highlight selected role card
document.querySelectorAll('.role-card input[type=radio]').forEach(radio => {
    radio.addEventListener('change', () => {
        document.querySelectorAll('.role-card').forEach(c => c.classList.remove('border-primary', 'bg-light'));
        if (radio.checked) radio.closest('.role-card').classList.add('border-primary', 'bg-light');
    });
    if (radio.checked) radio.closest('.role-card').classList.add('border-primary', 'bg-light');
});
</script>
}
