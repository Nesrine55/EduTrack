@model IEnumerable<PerformanceEtudiante.Models.TeacherAssignment>

@{
    ViewData["Title"] = "Liste des affectations";
}
<h2>Liste des affectations</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Liste des affectations</h2>

        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Nouvelle affectation
        </a>
    </div>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Enseignant</th>
                <th>Classe</th>
                <th>Groupe</th>
                <th>Matière</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Enseignant.UserName</td>
                    <td>@item.Classe.Nom</td>
                    <td>@item.Groupe.Nom</td>
                    <td>@item.Matiere.Nom</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Modifier</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Supprimer</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>