@model PerformanceEtudiante.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="px-3">
    <!-- Header de bienvenue -->
    <div class="card border-0 shadow-sm mb-4" style="background: linear-gradient(135deg, #1a73e8 0%, #0d47a1 100%);">
        <div class="card-body p-4 text-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h3 class="fw-bold mb-1">Bonjour, @Model.NomComplet 👋</h3>
                    <p class="mb-0 opacity-75">
                        <i class="fas fa-user-tag me-1"></i>@Model.Role
                        &nbsp;|&nbsp;
                        <i class="fas fa-calendar me-1"></i>@DateTime.Now.ToString("dddd d MMMM yyyy", new System.Globalization.CultureInfo("fr-FR"))
                    </p>
                </div>
                <div>
                    @if (!string.IsNullOrEmpty(Model.PhotoProfil))
                    {
                        <img src="~/uploads/profils/@Model.PhotoProfil" class="rounded-circle border border-white border-3" width="70" height="70" style="object-fit:cover;" />
                    }
                    else
                    {
                        <div style="width:70px;height:70px;background:rgba(255,255,255,0.2);border-radius:50%;border:3px solid white;display:flex;align-items:center;justify-content:center;">
                            <i class="fas fa-user fa-2x text-white"></i>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* <!-- Sprint 1 - Fonctionnalités réalisées -->
    <h5 class="fw-bold mb-3 text-muted"><i class="fas fa-rocket me-2 text-primary"></i>Sprint 1 — Fonctionnalités disponibles</h5>
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div style="width:45px;height:45px;background:#e8f0fe;border-radius:12px;display:flex;align-items:center;justify-content:center;">
                            <i class="fas fa-sign-in-alt text-primary fa-lg"></i>
                        </div>
                        <div class="ms-3">
                            <span class="badge bg-primary bg-opacity-10 text-primary small">US1</span>
                            <h6 class="mb-0 fw-bold">Authentification</h6>
                        </div>
                    </div>
                    <p class="text-muted small mb-3">Connexion sécurisée avec redirection vers le dashboard selon le rôle.</p>
                    <span class="badge bg-success"><i class="fas fa-check me-1"></i>Réalisé</span>
                </div>
            </div>
        </div> *@

        @if (User.IsInRole("Administrateur"))
        {
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-3">
                            <div style="width:45px;height:45px;background:#fce8e6;border-radius:12px;display:flex;align-items:center;justify-content:center;">
                                <i class="fas fa-users-cog text-danger fa-lg"></i>
                            </div>
                            <div class="ms-3">
@*                                 <span class="badge bg-danger bg-opacity-10 text-danger small">US2</span>
 *@                                <h6 class="mb-0 fw-bold">Gestion des rôles</h6>
                            </div>
                        </div>
                        <p class="text-muted small mb-3">Attribution des rôles étudiant / enseignant / admin.</p>
                        <a asp-controller="Account" asp-action="GestionUtilisateurs" class="btn btn-danger btn-sm">
                            <i class="fas fa-arrow-right me-1"></i>Gérer les utilisateurs
                        </a>
                    </div>
                </div>
            </div>
        }

        @* <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div style="width:45px;height:45px;background:#e6f4ea;border-radius:12px;display:flex;align-items:center;justify-content:center;">
                            <i class="fas fa-user-edit text-success fa-lg"></i>
                        </div>
                        <div class="ms-3">
                            <span class="badge bg-success bg-opacity-10 text-success small">US3</span>
                            <h6 class="mb-0 fw-bold">Modifier le profil</h6>
                        </div>
                    </div>
                    <p class="text-muted small mb-3">Mise à jour des informations personnelles et photo.</p>
                    <a asp-controller="Profile" asp-action="Index" class="btn btn-success btn-sm">
                        <i class="fas fa-arrow-right me-1"></i>Modifier mon profil
                    </a>
                </div>
            </div>
        </div> *@
    </div>

    <!-- Prochains sprints -->
    @* <h5 class="fw-bold mb-3 text-muted"><i class="fas fa-clock me-2 text-secondary"></i>Prochains sprints (à venir)</h5>
    <div class="row g-3">
        @{
            var prochains = new[]
            {
                new { Icon = "clipboard-list", Color = "warning", US = "US4-US7", Titre = "Gestion des notes", Desc = "Saisie, consultation et historique des notes" },
                new { Icon = "chart-line", Color = "info", US = "US8-US9", Titre = "Suivi de performance", Desc = "Indicateurs de réussite et évolution" },
                new { Icon = "tachometer-alt", Color = "primary", US = "US10-US11", Titre = "Tableau de bord", Desc = "Graphiques et vue synthétique" },
                new { Icon = "exclamation-triangle", Color = "danger", US = "US12-US14", Titre = "Analyse de risque", Desc = "Détection des étudiants à risque" },
            };
        }
        @foreach (var item in prochains)
        {
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100 opacity-75">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center mb-2">
                            <i class="fas fa-@item.Icon text-@item.Color fa-lg me-2"></i>
                            <span class="badge bg-secondary bg-opacity-10 text-secondary small">@item.US</span>
                        </div>
                        <h6 class="fw-bold mb-1">@item.Titre</h6>
                        <p class="text-muted small mb-0">@item.Desc</p>
                    </div>
                    <div class="card-footer bg-transparent border-0 pt-0 pb-3 px-3">
                        <span class="badge bg-secondary"><i class="fas fa-hourglass-half me-1"></i>En attente</span>
                    </div>
                </div>
            </div>
        }
    </div> *@
</div>
