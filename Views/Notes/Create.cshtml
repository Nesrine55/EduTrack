@model NoteViewModel
@using Microsoft.AspNetCore.Identity
@{
    ViewData["Title"] = "Ajouter une note";
}
<h2>Ajouter une note</h2>
<form asp-action="Create" method="post" class="row g-3">
    @Html.AntiForgeryToken()
    <div class="col-md-6">
        <label asp-for="GroupeId" class="form-label">Groupe</label>
        <select asp-for="GroupeId" class="form-select" asp-items="Model.Groupes" id="GroupeId">
            <option value="">Sélectionner un groupe</option>
        </select>
        <span asp-validation-for="GroupeId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="EtudiantId" class="form-label">Étudiant</label>
        <select asp-for="EtudiantId" class="form-select" id="EtudiantId">
            <option value="">Sélectionner un étudiant</option>
        </select>
        <span asp-validation-for="EtudiantId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="MatiereId" class="form-label">Matière</label>
        <select asp-for="MatiereId" class="form-select" asp-items="@(new SelectList(Model.Matieres, "Id", "Nom"))">
            <option value="0">Sélectionner une matière</option>
        </select>
        <span asp-validation-for="MatiereId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Valeur" class="form-label">Note</label>
        <input asp-for="Valeur" class="form-control" type="number" min="0" max="20" step="0.01" />
        <span asp-validation-for="Valeur" class="text-danger"></span>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-success">Enregistrer</button>
        <a asp-action="Index" class="btn btn-secondary">Annuler</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const groupeSelect = document.getElementById("GroupeId");
        const etudiantSelect = document.getElementById("EtudiantId");

        async function loadStudents() {
            const groupeId = groupeSelect.value;
            etudiantSelect.innerHTML = '<option value="">Sélectionner un étudiant</option>';

            if (!groupeId) return;

            const res = await fetch(`/Notes/StudentsByGroupe?groupeId=${groupeId}`);
            if (!res.ok) return;

            const students = await res.json();
            students.forEach(s => {
                const opt = document.createElement("option");
                opt.value = s.id;
                opt.textContent = s.name;
                etudiantSelect.appendChild(opt);
            });
        }

        groupeSelect.addEventListener("change", loadStudents);
    </script>
}
