@model Note
@{
    ViewData["Title"] = "Supprimer la note";
}
<h2>Supprimer la note</h2>
<div class="card border-danger mb-3">
    <div class="card-header bg-danger text-white">
        Confirmation de suppression
    </div>
    <div class="card-body">
        <h5 class="card-title">Êtes-vous sûr de vouloir supprimer cette note ?</h5>
        <dl class="row">
            <dt class="col-sm-3">Étudiant</dt>
            <dd class="col-sm-9">@Model.Etudiant.UserName</dd>
            <dt class="col-sm-3">Matière</dt>
            <dd class="col-sm-9">@Model.Matiere.Nom</dd>
            <dt class="col-sm-3">Note</dt>
            <dd class="col-sm-9">@Model.Valeur</dd>
            <dt class="col-sm-3">Date</dt>
            <dd class="col-sm-9">@Model.DateAjout.ToShortDateString()</dd>
        </dl>
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Supprimer</button>
            <a asp-action="Index" class="btn btn-secondary">Annuler</a>
        </form>
    </div>
</div>
