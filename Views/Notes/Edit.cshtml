@model NoteViewModel
@using Microsoft.AspNetCore.Identity
@{
    ViewData["Title"] = "Modifier la note";
}
<h2>Modifier la note</h2>
<form asp-action="Edit" method="post" class="row g-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div class="col-md-6">
        <label asp-for="EtudiantId" class="form-label">Étudiant</label>
        <select asp-for="EtudiantId" class="form-select" asp-items="@(new SelectList(Model.Etudiants, "Id", "UserName", Model.EtudiantId))">
            <option value="">Sélectionner un étudiant</option>
        </select>
        <span asp-validation-for="EtudiantId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="MatiereId" class="form-label">Matière</label>
        <select asp-for="MatiereId" class="form-select" asp-items="@(new SelectList(Model.Matieres, "Id", "Nom", Model.MatiereId))">
            <option value="">Sélectionner une matière</option>
        </select>
        <span asp-validation-for="MatiereId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Valeur" class="form-label">Note</label>
        <input asp-for="Valeur" class="form-control" type="number" min="0" max="20" step="0.01" />
        <span asp-validation-for="Valeur" class="text-danger"></span>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a asp-action="Index" class="btn btn-secondary">Annuler</a>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
